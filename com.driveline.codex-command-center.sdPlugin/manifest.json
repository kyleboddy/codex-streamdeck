{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Name": "Brainpower",
      "UUID": "com.driveline.codex-command-center.reasoning",
      "Icon": "imgs/action-list/brainpower",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "Icon": "imgs/actions/brainpower",
        "layout": "$B1",
        "StackColor": "#10A37F",
        "TriggerDescription": {
          "Rotate": "Choose Light through Ultra reasoning",
          "Push": "Reset to High"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/brainpower"
        }
      ]
    },
    {
